# Fern notifications (dunst). Minimal: no icons, 1px border, regular weight.
[global]
    font = JetBrainsMono Nerd Font Mono 12
    format = "%s\n%b"
    markup = no
    icon_position = off
    width = (0, 360)
    origin = top-right
    offset = (16, 56)
    padding = 12
    horizontal_padding = 12
    frame_width = 1
    corner_radius = 0
    gap_size = 8
    separator_height = 0
    show_indicators = no
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

[urgency_low]
    background = "#120e08"
    foreground = "#8c734e"
    frame_color = "#8c734e"
    timeout = 4

[urgency_normal]
    background = "#120e08"
    foreground = "#b3976d"
    frame_color = "#b3976d"
    highlight = "#b3976d"
    timeout = 4

[urgency_critical]
    background = "#120e08"
    foreground = "#d1b994"
    frame_color = "#d1b994"
    highlight = "#d1b994"
    timeout = 0
