# Fern notifications (dunst). Minimal: no icons, 1px border, regular weight.
[global]
    font = JetBrainsMono Nerd Font Mono 12
    format = "%s\n%b"
    markup = no
    icon_position = off
    width = (0, 360)
    origin = top-right
    offset = (16, 56)
    padding = 12
    horizontal_padding = 12
    frame_width = 1
    corner_radius = 0
    gap_size = 8
    separator_height = 0
    show_indicators = no
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

[urgency_low]
    background = "#0b0b0b"
    foreground = "#808080"
    frame_color = "#808080"
    timeout = 4

[urgency_normal]
    background = "#0b0b0b"
    foreground = "#bcbcbc"
    frame_color = "#bcbcbc"
    highlight = "#bcbcbc"
    timeout = 4

[urgency_critical]
    background = "#0b0b0b"
    foreground = "#d6d6d6"
    frame_color = "#bcbcbc"
    highlight = "#d6d6d6"
    timeout = 0
