# Fern notifications (dunst). Minimal: no icons, 1px border, regular weight.
[global]
    font = JetBrainsMono Nerd Font Mono 12
    format = "%s\n%b"
    markup = no
    icon_position = off
    width = (0, 360)
    origin = top-right
    offset = (16, 56)
    padding = 12
    horizontal_padding = 12
    frame_width = 1
    corner_radius = 0
    gap_size = 8
    separator_height = 0
    show_indicators = no
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

[urgency_low]
    background = "#0f1613"
    foreground = "#73886f"
    frame_color = "#73886f"
    timeout = 4

[urgency_normal]
    background = "#0f1613"
    foreground = "#b9c9b0"
    frame_color = "#a5b98f"
    highlight = "#a5b98f"
    timeout = 4

[urgency_critical]
    background = "#0f1613"
    foreground = "#e4ecd8"
    frame_color = "#e4ecd8"
    highlight = "#e4ecd8"
    timeout = 0
