# Fern notifications (dunst). Minimal: no icons, 1px border, regular weight.
[global]
    font = JetBrainsMono Nerd Font Mono 12
    format = "%s\n%b"
    markup = no
    icon_position = off
    width = (0, 360)
    origin = top-right
    offset = (16, 56)
    padding = 12
    horizontal_padding = 12
    frame_width = 1
    corner_radius = 0
    gap_size = 8
    separator_height = 0
    show_indicators = no
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

[urgency_low]
    background = "#0d1512"
    foreground = "#6a8a72"
    frame_color = "#6a8a72"
    timeout = 4

[urgency_normal]
    background = "#0d1512"
    foreground = "#b5d1b0"
    frame_color = "#9cc79a"
    highlight = "#9cc79a"
    timeout = 4

[urgency_critical]
    background = "#0d1512"
    foreground = "#dff0d6"
    frame_color = "#dff0d6"
    highlight = "#dff0d6"
    timeout = 0
