{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 8,
    "margin-right": 8,
    "margin-bottom": 0,
    "margin-left": 8,

    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    "modules-right": ["custom/vpn", "tray", "battery", "pulseaudio", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "custom/vpn": {
        "exec": "nmcli -t -f TYPE connection show --active | grep -qE '^(vpn|wireguard)' && echo '󰖂 VPN'",
        "interval": 3,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "battery": {
        "format": "󰁹 {capacity}%",
        "interval": 5,
        "states": { "warning": 20, "critical": 10 },
        "tooltip": false
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "󰕾 {volume}%",
        "format-bluetooth": "󰕾 {volume}%",
        "format-muted": "󰖁",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "tooltip": false
    }
}
