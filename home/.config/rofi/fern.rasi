* {
    bg:     #120e08;
    fg:     #8c734e;
    acc:    #b3976d;
    sel:    #d1b994;
    font:   "JetBrainsMono Nerd Font Mono 14";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 400px;
    padding: 20px;
    background-color: @bg;
    border: 1px;
    border-color: @acc;
}

mainbox { children: [ inputbar, listview ]; }

inputbar {
    spacing: 8px;
    margin: 0 0 12px 0;
    children: [ prompt, entry ];
}

prompt { text-color: @acc; }
entry  { text-color: @acc; placeholder: ""; }

listview {
    lines: 8;
    scrollbar: false;
}

element { padding: 2px 0; }
element normal.normal, element alternate.normal { text-color: @fg; }
element selected.normal { background-color: transparent; text-color: @sel; }
